# ============================================================================
# Strict Docker Context (API/Worker + SpiceDB images)
# Keep build context minimal: only files required by the Dockerfiles.
# ============================================================================

# Ignore everything by default.
**

# ---------- API/Worker image inputs ----------
!requirements.txt
!manage.py
!apps/
!apps/**
!admin/
!admin/**
!voyant_project/
!voyant_project/**

# ---------- SpiceDB wrapper image input ----------
!infra/standalone/scripts/spicedb-entrypoint.sh

# ---------- Re-ignore things that leak into allowed dirs ----------
# Python bytecode — 46 dirs inside apps/, never needed in image
**/__pycache__/

# Test suites — not needed in production image
**/tests/
